# ==== Supabase (projeto GE EASY) ====
NEXT_PUBLIC_SUPABASE_URL=https://oiwmydggyloqezfsajxp.supabase.co
# Chave publicável (pode ficar no front-end; o acesso é protegido por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Chave de serviço — SOMENTE no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do sistema (usada em convites, OAuth e links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== Criptografia dos tokens de integração (32 bytes em base64) ====
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ==== Google Workspace (Agenda + Drive) — opcional ====
# Console Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <NEXT_PUBLIC_SITE_URL>/api/integracoes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
