# ==== Supabase (projeto GE EASY) ====
NEXT_PUBLIC_SUPABASE_URL=https://oiwmydggyloqezfsajxp.supabase.co
# Chave publicável (pode ficar no front-end; o acesso é protegido por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Chave de serviço — SOMENTE no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do sistema (usada em convites, OAuth e links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== Criptografia dos tokens de integração (32 bytes em base64) ====
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ==== Google Workspace (Agenda + Drive) — opcional ====
# Console Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <NEXT_PUBLIC_SITE_URL>/api/integracoes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==== Rotina de sincronização (DataJud, DJEN, Drive, Agenda) ====
# Segredo do endpoint /api/cron/sincronizar (mín. 32 caracteres). O mesmo valor fica no
# Vault do Supabase como "geeasy_cron_secret" (o pg_cron chama a rota com ele).
# Gere com: openssl rand -hex 32
CRON_SECRET=

# ==== DataJud (CNJ) — opcional ====
# Por padrão usa a chave pública divulgada pelo CNJ. Se o CNJ trocar a chave, informe aqui.
DATAJUD_API_KEY=

# ==== Multiempresa (opcional) ====
# Domínio raiz das empresas: cada empresa acessa por <slug>.<domínio> (exige domínio curinga *.dominio na Vercel).
# Vazio: após o login o usuário escolhe a empresa (/selecionar-empresa).
NEXT_PUBLIC_ROOT_DOMAIN=

# ==== Integrações das fases 4–10 (todas opcionais; sem a chave o recurso fica desligado) ====
# Push do app de campo (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@exemplo.com.br
# Google Maps: ative "Geocoding API" e "Routes API" no Google Cloud (a Directions antiga não serve em projeto novo).
# Restrinja a chave a essas duas APIs. Sem chave usa OpenStreetMap e vizinho mais próximo.
GOOGLE_MAPS_API_KEY=
# OCR de documentos (Google Vision; a empresa liga/desliga em Configurações › Empresa)
GOOGLE_VISION_API_KEY=
# WhatsApp Cloud API / Lead Ads (webhook: <SITE>/api/webhooks/meta)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Anti-robô dos formulários públicos (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cobrança das assinaturas (Asaas; webhook: <SITE>/api/webhooks/asaas com o token abaixo)
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
# Domínio próprio das empresas (token da Vercel com acesso ao projeto)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# E-mail do relatório mensal (Resend)
RESEND_API_KEY=
EMAIL_FROM=GE EASY <nao-responda@exemplo.com.br>
